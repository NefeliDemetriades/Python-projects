class Timer(Label):
    def recreate_timer(self):
        minutes = int(self.current_time) // 60
        seconds = int(self.current_time) % 60
        # Calculate the correct minutes/seconds and put them into the correct format inside the 'time_string' variable
        time_string = "{:02}:{:02}".format(minutes , seconds)

        Label.__init__(self, self.width, self.height, self.text_red, self.text_green, self.text_blue, self.position.x,
                       self.position.y, time_string, self.font, self.frame_red, self.frame_green, self.frame_blue,
                       self.frame_image_path)

    def __init__(self, width: int, height: int, text_red: int, text_green: int, text_blue: int, x: float, y: float,
                 font: pygame.font.SysFont, start_time: float, time_scale: float, frame_red: int = None,
                 frame_green: int = None, frame_blue: int = None, frame_image_path: str = None):
        Label.__init__(self, width, height, text_red, text_green, text_blue, x, y, "0:0", font, frame_red=frame_red,
                       frame_green=frame_green, frame_blue=frame_blue, frame_image_path=frame_image_path)
        self.text_red = text_red
        self.text_green = text_green
        self.text_blue = text_blue
        self.frame_red = frame_red
        self.frame_green = frame_green
        self.frame_blue = frame_blue
        self.frame_image_path = frame_image_path
        self.current_time = start_time
        self.time_scale = time_scale

    def update(self, dt: float):
        # Update the 'current_time' property based on dt and the time_scale, then recreate the timer
        self.current_time += dt * self.time_scale
        self.recreate_timer()

class World(Sprite):
    def clear(self):
        self.surface.fill((0 , 0, 0))

    def draw(self , sprite: Sprite):
        self.surface.blit(sprite.surface , (sprite.position.x , sprite.position.y))

    def focus_on(self , point:Vector , window_width: int , window_height: int):
        """
        the function moves the world around so the point remains at the center
        :param point: the target
        :param window_width: the width of the world
        :param window_height: the height of the world
        :return: gives the position x and position y
        """
        self.position.x = -(point.x - window_width / 2)
        self.position.y = -(point.y - window_height / 2)
